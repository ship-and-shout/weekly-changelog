{
  "name": "weekly-changelog",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action: keep CHANGELOG.md current with a weekly PR built from your real commits, PRs and releases.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --license licenses.txt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
